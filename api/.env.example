# Server
PORT=3000
HOST=127.0.0.1

# Auth
JWT_SECRET=your-jwt-secret
IP_HASH_SALT=your-ip-hash-salt

# Discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://disc-tools.de/auth/callback
DISCORD_BOT_TOKEN=your-bot-token
GUILD_ID=your-guild-id
DISCORD_INVITE=https://discord.gg/yourinvite

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disctools
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Spotify OAuth
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=your-spotify-redirect-uri

# Twitch OAuth
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_REDIRECT_URI=your-twitch-redirect-uri

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=your-github-redirect-uri

# Internal
GIFS_INTERNAL_SECRET=your-internal-secret
